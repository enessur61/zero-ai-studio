# Copy to .env for local development.
# Never commit real API keys or secrets.
GEMINI_API_KEY=
# Set true ONLY after confirming billing is disabled for the Google Cloud project.
ZERO_GEMINI_FREE_TIER_ONLY=false
PORT=3000
APP_URL=http://localhost:3000

# Production database (Neon PostgreSQL or compatible PostgreSQL).
# Required in production; never commit a real connection string.
DATABASE_URL=

# Optional Cloudflare Workers AI. Both independent gates must be explicitly enabled after checking the account plan.
# Free-plan confirmation is an operator attestation, not automatic billing verification. No paid fallback.
ZERO_CLOUDFLARE_AI_ENABLED=false
ZERO_CLOUDFLARE_WORKERS_FREE_PLAN_CONFIRMED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Self-hosted Wan GPU is separately disabled by default. GPU hosting/runtime may be billable.
ZERO_WAN_GPU_ENABLED=false
ZERO_WAN_GPU_COSTS_CONFIRMED=false
ZERO_WAN_GPU_DAILY_JOB_LIMIT=3

# Required for production: use a unique password (12+ chars) and random secret (32+ chars).
ZERO_ADMIN_PASSWORD=
ZERO_SESSION_SECRET=
