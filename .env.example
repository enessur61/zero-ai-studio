# Copy to .env for local development.
# Never commit real API keys or secrets.
GEMINI_API_KEY=
# Set true ONLY after confirming billing is disabled for the Google Cloud project.
ZERO_GEMINI_FREE_TIER_ONLY=false
PORT=3000
APP_URL=http://localhost:3000

# Production database (Neon PostgreSQL or compatible PostgreSQL).
# Required in production; never commit a real connection string.
DATABASE_URL=

# Optional free-tier Cloudflare Workers AI for ZERO CORE (GLM), FLUX Image Studio and Whisper transcription.
# Cloudflare Free has a shared daily Neuron allocation across Workers AI models; no paid fallback is used.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required for production: use a unique password (12+ chars) and random secret (32+ chars).
ZERO_ADMIN_PASSWORD=
ZERO_SESSION_SECRET=
