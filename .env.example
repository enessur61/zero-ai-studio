# Copy to .env for local development.
# Never commit real API keys or secrets.
GEMINI_API_KEY=
# Set true ONLY after confirming billing is disabled for the Google Cloud project.
ZERO_GEMINI_FREE_TIER_ONLY=false
PORT=3000
APP_URL=http://localhost:3000

# Production database (Neon PostgreSQL or compatible PostgreSQL).
# Required in production; never commit a real connection string.
DATABASE_URL=

# Optional Cloudflare Workers AI for ZERO CORE (GLM), FLUX, Whisper and Moondream.
# Requests are blocked by default, even when credentials exist.
# Only set BOTH flags after manually verifying the account is on Workers Free and cannot incur paid AI usage.
# These are operator attestations, not an automatic check of Cloudflare billing settings.
# Regression coverage: run npm test locally; do not use live model probes as a cost test.
# Cloudflare 5xx responses are not retried, avoiding potentially duplicated metered requests.
ZERO_CLOUDFLARE_AI_ENABLED=false
ZERO_CLOUDFLARE_WORKERS_FREE_PLAN_CONFIRMED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required for production: use a unique password (12+ chars) and random secret (32+ chars).
ZERO_ADMIN_PASSWORD=
ZERO_SESSION_SECRET=
