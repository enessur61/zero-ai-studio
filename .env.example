# Copy to .env for local development.
# Never commit real API keys or secrets.
GEMINI_API_KEY=
# Set true ONLY after confirming billing is disabled for the Google Cloud project.
ZERO_GEMINI_FREE_TIER_ONLY=false
PORT=3000
APP_URL=http://localhost:3000

# Production database (Neon PostgreSQL or compatible PostgreSQL).
# Required in production; never commit a real connection string.
DATABASE_URL=

# Optional free-tier Cloudflare Workers AI for ZERO CORE (GLM), FLUX Image Studio and Whisper transcription.
# Cloudflare Free has a shared daily Neuron allocation across Workers AI models; no paid fallback is used.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Both flags must be explicitly set only after confirming the Workers Free plan and excluding paid usage.
ZERO_CLOUDFLARE_AI_ENABLED=false
ZERO_CLOUDFLARE_WORKERS_FREE_PLAN_CONFIRMED=false

# Optional self-hosted Wan GPU. Disabled by default because GPU hosting may be billable.
ZERO_WAN_GPU_ENABLED=false
ZERO_WAN_GPU_COSTS_CONFIRMED=false
ZERO_WAN_GPU_DAILY_JOB_LIMIT=3

# Required for production: use a unique password (12+ chars) and random secret (32+ chars).
ZERO_ADMIN_PASSWORD=
ZERO_SESSION_SECRET=


# ZERO COST / RESOURCE GUARD — fail-closed defaults. Enable only after verifying
# that the provider account is actually on the free tier and PostgreSQL is configured.
ZERO_COST_GUARD_ENABLED=false
ZERO_COST_GUARD_FREE_ONLY_CONFIRMED=false
ZERO_COST_GUARD_DAILY_REQUEST_LIMIT=100
ZERO_CLOUDFLARE_AI_ENABLED=false
ZERO_CLOUDFLARE_WORKERS_FREE_PLAN_CONFIRMED=false
ZERO_COST_RESOURCE_GUARD_ENABLED=false
ZERO_COST_RESOURCE_GUARD_FREE_ONLY_CONFIRMED=false

# Server-side resource ceilings (units/day and maximum concurrent operations).
ZERO_RESOURCE_TEXT_DAILY_LIMIT=20
ZERO_RESOURCE_TEXT_CONCURRENCY=3
ZERO_RESOURCE_IMAGE_DAILY_LIMIT=5
ZERO_RESOURCE_IMAGE_CONCURRENCY=1
ZERO_RESOURCE_AUDIO_DAILY_LIMIT=10
ZERO_RESOURCE_AUDIO_CONCURRENCY=1
ZERO_RESOURCE_VIDEO_DAILY_LIMIT=12
ZERO_RESOURCE_VIDEO_CONCURRENCY=1
