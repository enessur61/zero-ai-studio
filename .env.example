# Copy to .env for local development.
# Never commit real API keys or secrets.
GEMINI_API_KEY=
# Set true ONLY after confirming billing is disabled for the Google Cloud project.
ZERO_GEMINI_FREE_TIER_ONLY=false
PORT=3000
APP_URL=http://localhost:3000

# Required for production: use a unique password (12+ chars) and random secret (32+ chars).
ZERO_ADMIN_PASSWORD=
ZERO_SESSION_SECRET=
