# Copy to production.env, chmod 600, and replace every placeholder.
NODE_ENV=production
DATABASE_URL=replace-with-your-postgresql-connection-string
ZERO_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
ZERO_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Must exactly match ZERO_TTS_WORKER_TOKEN in .env.workers.
ZERO_TTS_WORKER_TOKEN=replace-with-the-same-random-worker-token
# Piper remains disabled until the self-hosted worker hosting costs are explicitly confirmed.
ZERO_PIPER_WORKER_ENABLED=false
ZERO_PIPER_WORKER_COSTS_CONFIRMED=false
# Must exactly match ZERO_VIDEO_ENGINE_TOKEN in .env.workers; the Wan worker remains opt-in.
ZERO_VIDEO_ENGINE_TOKEN=replace-with-the-same-random-worker-token
ZERO_WAN_GPU_ENABLED=false
ZERO_WAN_GPU_COSTS_CONFIRMED=false
ZERO_WAN_GPU_DAILY_JOB_LIMIT=3
# Gemini stays disabled unless its free-only billing state is independently verified.
ZERO_GEMINI_FREE_TIER_ONLY=false
