# Required. Use the same long random secret in ZERO AI STUDIO and this worker.
ZERO_VIDEO_ENGINE_TOKEN=replace-with-a-long-random-secret
# Optional: defaults to the official Wan 2.1 T2V 1.3B Diffusers checkpoint.
WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
WAN_OUTPUT_DIR=/tmp/zero-wan-jobs

# Both flags are required; worker enforces a hard maximum of 3 accepted jobs per UTC day.
ZERO_WAN_GPU_ENABLED=false
ZERO_WAN_GPU_COSTS_CONFIRMED=false
ZERO_WAN_GPU_DAILY_JOB_LIMIT=3
