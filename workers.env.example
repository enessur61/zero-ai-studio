# Generate a cryptographically random secret of at least 32 characters.
# Use the identical ZERO_TTS_WORKER_TOKEN in production.env and this file.
ZERO_TTS_WORKER_TOKEN=replace-with-a-long-random-secret

# Used only by the optional GPU video worker.
